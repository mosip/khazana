<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.mosip.commons</groupId>
		<artifactId>khazana-parent</artifactId>
		<version>1.4.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>khazana</artifactId>
	<version>1.4.1-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>khazana</name>
	<description>
		MOSIP object-store library. Pluggable ObjectStoreAdapter implementations:
		S3Adapter (Amazon S3 / MinIO, AWS SDK 1.x), PosixAdapter (one zip per container),
		and SwiftAdapter (OpenStack Swift via JOSS, not fully tested). Callers inject the
		adapter with Spring @Qualifier names S3Adapter, PosixAdapter, or SwiftAdapter.
		Pure library JAR for Maven Central — Boot 4.1.1, Java 21, no kernel-bom.
		Depends on io.mosip.kernel:kernel-core:1.4.1-SNAPSHOT.
	</description>
	<url>https://github.com/mosip/khazana</url>

	<!-- Inherits plugin versions, JaCoCo 90% gate, and dependencyManagement from khazana-parent. -->
	<properties>
		<sonar.coverage.exclusions>
			**/constant/**,**/config/**,**/dto/**,**/entity/**,**/model/**,**/exception/**,**/repository/**,**/*Config.java
		</sonar.coverage.exclusions>
	</properties>

	<dependencies>
		<!--
			kernel-core: exceptions (BaseUncheckedException), CryptoUtil, DateUtils2, FileUtils,
			and the logback Logfactory used by LoggerConfiguration. Version ${kernel.core.version}.
			MPL-2.0. Do not pull kernel-bom or a separate kernel-logger-logback JAR — the logger
			implementation is folded into kernel-core 1.4.1-SNAPSHOT.
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-core</artifactId>
		</dependency>
		<!--
			kernel-keymanager-service: CryptomanagerService / CryptomanagerServiceImpl for
			PosixAdapter.pack() via OfflineEncryptionUtil. Classifier lib is the library JAR
			(the main artifact is the Spring Boot service). Exclude its older kernel-core so
			1.4.1-SNAPSHOT wins. Exclude spring-security-config to avoid pulling a second
			security stack into this library.
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-keymanager-service</artifactId>
			<classifier>lib</classifier>
			<exclusions>
				<exclusion>
					<groupId>io.mosip.kernel</groupId>
					<artifactId>kernel-core</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.springframework.security</groupId>
					<artifactId>spring-security-config</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!--
			spring-boot-starter: @Service / @Component / @Value / logging for the adapters.
			Version from Boot parent 4.1.1. License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<!--
			spring-web: RestTemplate used by OnlineCryptoUtil to call cryptomanager encrypt/decrypt.
			Version from Boot parent (Spring Framework 7). License: Apache-2.0.
		-->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<!--
			jackson-databind: ObjectMapper for POSIX zip metadata JSON. Version from Boot 4.1.1
			Jackson 2 line (spring-boot-jackson2 is pulled by kernel-core). License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<!--
			aws-java-sdk-s3: AmazonS3 client. S3Adapter keeps the 1.x API (bucket lowercase,
			Tags/ prefix objects, connection reset on failure). Version ${aws.sdk.v1.version}.
		-->
		<dependency>
			<groupId>com.amazonaws</groupId>
			<artifactId>aws-java-sdk-s3</artifactId>
		</dependency>
		<!--
			AWS SDK v2 metrics + HTTP: S3PoolStatsLogger implements MetricPublisher and reads
			HttpMetric from the Apache client. Not used by the 1.x AmazonS3 connection path.
		-->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
		</dependency>
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>apache-client</artifactId>
		</dependency>
		<!--
			joss: SwiftAdapter account/container/object calls. Version ${joss.version}.
		-->
		<dependency>
			<groupId>org.javaswift</groupId>
			<artifactId>joss</artifactId>
		</dependency>
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>
		<dependency>
			<groupId>org.json</groupId>
			<artifactId>json</artifactId>
		</dependency>
	</dependencies>
</project>
